{
  "name": "@afyalink/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "jest"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@afyalink/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/jest": "29.5.14",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"]
  }
}
