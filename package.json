{
  "name": "afyalink-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AfyaLink AI — healthcare operations platform (MVP)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:shared": "pnpm --filter @afyalink/shared build",
    "dev:api": "pnpm --filter @afyalink/api dev",
    "dev:web": "pnpm --filter @afyalink/web dev",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:shared && pnpm -r test",
    "test:e2e": "pnpm --filter @afyalink/web test:e2e",
    "db:migrate": "pnpm --filter @afyalink/api prisma:migrate",
    "db:seed": "pnpm --filter @afyalink/api prisma:seed"
  }
}
