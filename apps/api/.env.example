# ── Core ──
NODE_ENV=development
PORT=4000
# Public origin of the web app (CORS + links in emails)
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://afyalink:afyalink_dev@localhost:5432/afyalink?schema=public
REDIS_URL=redis://localhost:6379

# ── Secrets (generate with: openssl rand -base64 48) ──
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32-byte key, base64 encoded (openssl rand -base64 32). Encrypts clinical content & MFA secrets.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false

# ── Background jobs ──
WORKERS_ENABLED=true

# ── AI provider (OpenAI-compatible). Leave blank to disable AI features (endpoints return 503). ──
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000

# ── Email (SMTP). Leave blank to disable email delivery. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AfyaLink AI <no-reply@example.com>

# ── SMS (Africa's Talking compatible). Leave blank to disable SMS. ──
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=

# ── Payments: only "sandbox" is supported until a real provider is approved ──
PAYMENT_PROVIDER=sandbox

# ── Seed: bootstrap platform admin (development only) ──
SEED_PLATFORM_ADMIN_EMAIL=admin@afyalink.local
SEED_PLATFORM_ADMIN_PASSWORD=
