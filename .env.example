# ── Root .env for docker compose. NEVER commit the real .env. ──
APP_ORIGIN=https://localhost
POSTGRES_USER=afyalink
POSTGRES_DB=afyalink
# Generate: openssl rand -base64 32 | tr -d '/+=' 
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32   (exactly 32 bytes, base64)
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=true
HTTP_PORT=80
HTTPS_PORT=443

# Bootstrap platform admin (first deploy only; remove afterwards)
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
# Synthetic demo clinic — staging only
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# Optional integrations (leave blank = disabled, never faked)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AfyaLink AI <no-reply@example.com>
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
